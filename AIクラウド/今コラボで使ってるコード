import subprocess, threading, re, time

# cloudflaredインストール
subprocess.run(["wget", "-q", "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb"])
subprocess.run(["dpkg", "-i", "cloudflared-linux-amd64.deb"])

# トンネル起動してURL取得
def get_url():
    proc = subprocess.Popen(
        ["cloudflared", "tunnel", "--url", "http://localhost:11434"],
        stderr=subprocess.PIPE, text=True
    )
    for line in proc.stderr:
        m = re.search(r'https://[a-z0-9\-]+\.trycloudflare\.com', line)
        if m:
            print(f"\n✓ URL取得成功！\n\n  {m.group()}\n")
            print("👆 このURLをサイトの接続欄に貼ってください")
            break

threading.Thread(target=get_url, daemon=True).start()
time.sleep(10)

